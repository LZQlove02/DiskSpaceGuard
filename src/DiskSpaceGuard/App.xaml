<Application x:Class="DiskSpaceGuard.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>

      <!-- ══════════════════════════════════════════════════════════════
           DSG Design System V2 · 2026-11-08

           ★ 颜色不写在这里。调色板是一份独立的 ResourceDictionary，
             ThemeService.Apply() 通过替换这个合并项来切主题：
               Themes/Light.xaml  ← 本文件预置的默认值（浅色唯一真源）
               Themes/Dark.xaml   ← 暗色（旧蓝调，待重做，见 §7-2）
             要让"同一个颜色只存在一处"，就必须让应用资源里没有色值副本。

           ★ 字体与样式与主题无关，留在本文件，不随调色板切换。
           ══════════════════════════════════════════════════════════════ -->
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Light.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <!-- 字体：逗号为 fallback 链，未安装 Noto Sans SC / Geist Mono 时自动回退 -->
      <FontFamily x:Key="UiFontFamily">Noto Sans SC, Microsoft YaHei UI</FontFamily>
      <FontFamily x:Key="MonoFontFamily">Geist Mono, Consolas</FontFamily>

      <!-- 行为设定保持原样，避免影响既有交互 -->
      <Style TargetType="Button">
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
      </Style>

      <!-- 进度条：WPF 默认用系统 Aero 绿 #06B025，与设计系统无关。
           默认模板的 PART_Indicator 取 Foreground、轨道取 Background，故只需设值。
           不自建模板，以免丢失不确定态动画。
           这里用 DynamicResource：颜色来自上面的合并字典，静态引用会受声明顺序约束。 -->
      <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Background" Value="{DynamicResource SoftBrush}"/>
      </Style>

    </ResourceDictionary>
  </Application.Resources>
</Application>
