<Application x:Class="DiskSpaceGuard.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="WindowBrush" Color="#F5F7FB"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SubtleBrush" Color="#FAFBFD"/>
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#172033"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="SoftBrush" Color="#EEF2FF"/>
    <SolidColorBrush x:Key="NavBrush" Color="#111827"/>
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#263449"/>
    <SolidColorBrush x:Key="NavTextBrush" Color="#D1D5DB"/>
    <SolidColorBrush x:Key="InfoBgBrush" Color="#E8F0FF"/>
    <SolidColorBrush x:Key="SuccessBgBrush" Color="#ECFDF5"/>
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#15803D"/>
    <SolidColorBrush x:Key="WarningBgBrush" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="WarningTextBrush" Color="#B45309"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#B91C1C"/>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
  </Application.Resources>
</Application>
