<Window x:Class="DiskSpaceGuard.CleanupRulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:DiskSpaceGuard.Services"
        Title="{Binding [Rules.Title], Source={x:Static svc:Loc.Instance}}"
        Width="900" Height="600" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}" FontFamily="{StaticResource UiFontFamily}" FontSize="13">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Text="{Binding [Rules.Heading], Source={x:Static svc:Loc.Instance}}"
               FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
    <TextBlock Grid.Row="1" Margin="0,7,0,0" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"
               Text="{Binding [Rules.Desc], Source={x:Static svc:Loc.Instance}}"/>

    <Grid Grid.Row="2" Margin="0,14,0,10">
      <StackPanel Orientation="Horizontal">
        <Button Content="{Binding [Rules.Reload], Source={x:Static svc:Loc.Instance}}" Click="Reload_Click" Margin="0" Padding="14,7" Background="{StaticResource SoftBrush}"
                Foreground="{StaticResource AccentBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Cursor="Hand"/>
        <Button x:Name="PreviewButton" Content="{Binding [Rules.Preview], Source={x:Static svc:Loc.Instance}}" Click="Preview_Click" Margin="10,0,0,0"
                Padding="14,7" Background="{StaticResource AccentBrush}" Foreground="{StaticResource OnAccentBrush}" BorderThickness="0"
                IsEnabled="False" Cursor="Hand"/>
      </StackPanel>
      <TextBlock x:Name="StatusText" HorizontalAlignment="Right" VerticalAlignment="Center"
                 Foreground="{StaticResource SecondaryTextBrush}" FontSize="11.5"
                 Text="{Binding [Rules.Statting], Source={x:Static svc:Loc.Instance}}"/>
    </Grid>

    <Border Grid.Row="3" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9">
      <ListView x:Name="SuggestionList" BorderThickness="0" Background="Transparent"
                SelectionMode="Single" SelectionChanged="SuggestionList_SelectionChanged">
        <ListView.View>
          <GridView>
            <GridViewColumn Header="{Binding [Rules.RuleId], Source={x:Static svc:Loc.Instance}}" Width="120" DisplayMemberBinding="{Binding RuleId}"/>
            <GridViewColumn Header="{Binding [Rules.Name], Source={x:Static svc:Loc.Instance}}" Width="130" DisplayMemberBinding="{Binding Name}"/>
            <GridViewColumn Header="{Binding [Rules.Path], Source={x:Static svc:Loc.Instance}}" Width="290" DisplayMemberBinding="{Binding Path}"/>
            <GridViewColumn Header="{Binding [List.Size], Source={x:Static svc:Loc.Instance}}" Width="90" DisplayMemberBinding="{Binding Size}"/>
            <GridViewColumn Header="{Binding [Rules.Files], Source={x:Static svc:Loc.Instance}}" Width="60" DisplayMemberBinding="{Binding Files}"/>
            <GridViewColumn Header="{Binding [Rules.Dirs], Source={x:Static svc:Loc.Instance}}" Width="60" DisplayMemberBinding="{Binding Dirs}"/>
            <GridViewColumn Header="{Binding [Rules.Excluded], Source={x:Static svc:Loc.Instance}}" Width="60" DisplayMemberBinding="{Binding Excluded}"/>
            <GridViewColumn Header="{Binding [Rules.Protection], Source={x:Static svc:Loc.Instance}}" Width="90" DisplayMemberBinding="{Binding Protection}"/>
          </GridView>
        </ListView.View>
      </ListView>
    </Border>

    <Border Grid.Row="4" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="12,9" Margin="0,10,0,0">
      <TextBlock x:Name="NoteText" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11.5"
                 Text="{Binding [Rules.SelectHint], Source={x:Static svc:Loc.Instance}}"/>
    </Border>

    <DockPanel Grid.Row="5" Margin="0,14,0,0" LastChildFill="False">
      <Button DockPanel.Dock="Right" Content="{Binding [Common.Close], Source={x:Static svc:Loc.Instance}}" Click="Close_Click" Padding="18,8"
              Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Cursor="Hand"/>
    </DockPanel>
  </Grid>
</Window>
