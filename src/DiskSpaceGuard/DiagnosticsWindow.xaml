<Window x:Class="DiskSpaceGuard.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:DiskSpaceGuard.Services"
        Title="{Binding [Diag.Title], Source={x:Static svc:Loc.Instance}}"
        Width="780" Height="660" MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}"
        ShowInTaskbar="False" FontFamily="Microsoft YaHei UI" FontSize="13">
  <Border Padding="22">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0">
        <TextBlock Text="{Binding [Diag.Title], Source={x:Static svc:Loc.Instance}}"
                   FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
        <TextBlock Text="{Binding [Diag.Desc], Source={x:Static svc:Loc.Instance}}"
                   Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
      </StackPanel>

      <CheckBox Grid.Row="1" x:Name="RedactCheck" Margin="0,12,0,0"
                Content="{Binding [Diag.Redact], Source={x:Static svc:Loc.Instance}}"
                Checked="Redact_Changed" Unchecked="Redact_Changed"/>

      <Border Grid.Row="2" Background="{StaticResource InfoBgBrush}" CornerRadius="8"
              Padding="10,8" Margin="0,10,0,0">
        <StackPanel>
          <TextBlock Text="{Binding [Diag.Files], Source={x:Static svc:Loc.Instance}}"
                     Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="11.5"/>
          <TextBlock x:Name="FilesText" Margin="0,4,0,0" FontSize="11"
                     Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <TextBox Grid.Row="3" x:Name="PreviewBox" Margin="0,10,0,0" IsReadOnly="True"
               FontFamily="Consolas" FontSize="11.5" Padding="10"
               TextWrapping="NoWrap" AcceptsReturn="True"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
               Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
               BorderThickness="1"/>

      <TextBlock Grid.Row="4" x:Name="StatusText" Margin="0,8,0,0" FontSize="11"
                 Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"/>

      <DockPanel Grid.Row="5" Margin="0,12,0,0" LastChildFill="False">
        <Button DockPanel.Dock="Right" x:Name="ExportButton"
                Content="{Binding [Diag.Export], Source={x:Static svc:Loc.Instance}}"
                Click="Export_Click" Padding="20,8" Margin="0"
                Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"/>
        <Button DockPanel.Dock="Right"
                Content="{Binding [Diag.Close], Source={x:Static svc:Loc.Instance}}"
                Click="Close_Click" Padding="18,8" Margin="0,0,10,0"
                Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
      </DockPanel>
    </Grid>
  </Border>
</Window>
