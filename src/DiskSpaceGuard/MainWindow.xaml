<Window x:Class="DiskSpaceGuard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:DiskSpaceGuard.Controls"
        xmlns:svc="clr-namespace:DiskSpaceGuard.Services"
        Title="{Binding [App.WindowTitle], Source={x:Static svc:Loc.Instance}}"
        Width="1200" Height="820" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}">
  <Window.Resources>
    <Style x:Key="SegButton" TargetType="Button">
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="Background" Value="{StaticResource CardBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"
                    BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}"
                    BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{StaticResource NavBrush}" Padding="18">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,26">
          <TextBlock Text="DiskSpaceGuard" Foreground="White" FontSize="19" FontWeight="Bold"/>
          <TextBlock Text="{Binding [App.Subtitle], Source={x:Static svc:Loc.Instance}}" Foreground="#9CA3AF" Margin="0,6,0,0"/>
        </StackPanel>
        <StackPanel>
          <Button Content="{Binding [Nav.Overview], Source={x:Static svc:Loc.Instance}}" Tag="Overview" Click="Navigation_Click" Background="{StaticResource NavSelectedBrush}" Foreground="White" BorderThickness="0"/>
          <Button Content="{Binding [Nav.Analysis], Source={x:Static svc:Loc.Instance}}" Tag="Analysis" Click="Navigation_Click" Background="Transparent" Foreground="{StaticResource NavTextBrush}" BorderThickness="0"/>
          <Button Content="{Binding [Nav.Duplicates], Source={x:Static svc:Loc.Instance}}" Tag="Duplicates" Click="Navigation_Click" Background="Transparent" Foreground="{StaticResource NavTextBrush}" BorderThickness="0"/>
          <Button Content="{Binding [Nav.Apps], Source={x:Static svc:Loc.Instance}}" Tag="Apps" Click="Navigation_Click" Background="Transparent" Foreground="{StaticResource NavTextBrush}" BorderThickness="0"/>
          <Button Content="{Binding [Nav.Hardware], Source={x:Static svc:Loc.Instance}}" Tag="Hardware" Click="Navigation_Click" Background="Transparent" Foreground="{StaticResource NavTextBrush}" BorderThickness="0"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding [Nav.Footer], Source={x:Static svc:Loc.Instance}}" Foreground="#9CA3AF" Margin="0,18,0,0" VerticalAlignment="Bottom"/>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" Margin="28">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="0,0,0,24" LastChildFill="False">
        <StackPanel>
          <TextBlock x:Name="PageTitle" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
          <TextBlock x:Name="PageSubtitle" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,6,0,0"/>
        </StackPanel>
        <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="{Binding [Top.Refresh], Source={x:Static svc:Loc.Instance}}" Click="Refresh_Click" VerticalAlignment="Center" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" Padding="20,10"/>
        <Button x:Name="SettingsButton" DockPanel.Dock="Right" Content="{Binding [Top.Settings], Source={x:Static svc:Loc.Instance}}" Click="Settings_Click" Margin="0,0,10,0" VerticalAlignment="Center" Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="16,9"/>
        <Button x:Name="LedgerButton" DockPanel.Dock="Right" Content="{Binding [Top.Ledger], Source={x:Static svc:Loc.Instance}}" Click="Ledger_Click" Margin="0,0,10,0" VerticalAlignment="Center" Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="16,9"/>
      </DockPanel>
      <Border Grid.Row="1" Background="{StaticResource InfoBgBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,18">
        <TextBlock Text="{Binding [Safety.Banner], Source={x:Static svc:Loc.Instance}}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
      </Border>
      <Grid Grid.Row="2">
        <Grid x:Name="OverviewPanel" Visibility="Visible">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
            <TextBlock Text="{Binding [Overview.Disks], Source={x:Static svc:Loc.Instance}}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
            <TextBlock x:Name="VolumeCountText" DockPanel.Dock="Right" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
          </DockPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="DriveCards">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Width="280" Margin="0,0,14,14" Padding="18" Background="{StaticResource CardBrush}" CornerRadius="12">
                    <StackPanel>
                      <DockPanel><TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/><TextBlock Text="{Binding StatusDisplay}" DockPanel.Dock="Right" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/></DockPanel>
                      <TextBlock Text="{Binding LabelDisplay}" Margin="0,5,0,0" Foreground="{StaticResource SecondaryTextBrush}"/>
                      <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="{Binding [Card.Type], Source={x:Static svc:Loc.Instance}}" Foreground="{StaticResource SecondaryTextBrush}"/>
                        <TextBlock Text="{Binding DriveType}" Foreground="{StaticResource SecondaryTextBrush}"/>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="{Binding [Card.Format], Source={x:Static svc:Loc.Instance}}" Foreground="{StaticResource SecondaryTextBrush}"/>
                        <TextBlock Text="{Binding Format}" Foreground="{StaticResource SecondaryTextBrush}"/>
                      </StackPanel>
                      <ProgressBar Height="8" Margin="0,16,0,12" Minimum="0" Maximum="1" Value="{Binding UsedRatio, Mode=OneWay}"/>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding [Card.Used], Source={x:Static svc:Loc.Instance}}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding UsedDisplay}" FontWeight="SemiBold"/>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding [Card.VolumeFree], Source={x:Static svc:Loc.Instance}}"/>
                        <TextBlock Text="{Binding VolumeFreeDisplay}"/>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding [Card.UserFree], Source={x:Static svc:Loc.Instance}}"/>
                        <TextBlock Text="{Binding FreeDisplay}"/>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding [Card.Total], Source={x:Static svc:Loc.Instance}}"/>
                        <TextBlock Text="{Binding TotalDisplay}"/>
                      </StackPanel>
                      <TextBlock Text="{Binding QuotaNote}" Margin="0,6,0,0" TextWrapping="Wrap"
                                 FontSize="11" Foreground="{StaticResource WarningTextBrush}">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding HasQuotaDifference}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{StaticResource DangerTextBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
        <Grid x:Name="AnalysisPanel" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <StackPanel>
              <WrapPanel>
                <TextBlock Text="{Binding [Scan.Disk], Source={x:Static svc:Loc.Instance}}" VerticalAlignment="Center" Margin="0,0,6,6" Foreground="{StaticResource SecondaryTextBrush}"/>
                <ComboBox x:Name="ScanVolumeCombo" Width="130" Margin="0,0,14,6"/>
                <TextBlock Text="{Binding [Scan.Mode], Source={x:Static svc:Loc.Instance}}" VerticalAlignment="Center" Margin="0,0,6,6" Foreground="{StaticResource SecondaryTextBrush}"/>
                <ComboBox x:Name="ScanModeCombo" Width="140" Margin="0,0,8,6" SelectionChanged="ScanModeCombo_SelectionChanged">
                  <ComboBoxItem Content="{Binding [Scan.Full], Source={x:Static svc:Loc.Instance}}" Tag="FullRecursive" IsSelected="True"/>
                  <ComboBoxItem Content="{Binding [Scan.Shallow], Source={x:Static svc:Loc.Instance}}" Tag="Shallow"/>
                  <ComboBoxItem Content="{Binding [Scan.Fast], Source={x:Static svc:Loc.Instance}}" Tag="FastThenFull"/>
                </ComboBox>
                <ComboBox x:Name="ScanDepthCombo" Width="58" Margin="0,0,14,6" IsEnabled="False" SelectedIndex="0">
                  <ComboBoxItem Content="1"/>
                  <ComboBoxItem Content="2"/>
                  <ComboBoxItem Content="3"/>
                </ComboBox>
                <Button x:Name="ScanStartButton" Content="{Binding [Scan.Start], Source={x:Static svc:Loc.Instance}}" Click="ScanStart_Click"
                        Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"
                        Padding="16,8" Margin="0,0,8,6"/>
                <Button x:Name="ScanPauseButton" Content="{Binding [Scan.Pause], Source={x:Static svc:Loc.Instance}}" Click="ScanPause_Click"
                        IsEnabled="False" Padding="14,8" Margin="0,0,8,6"/>
                <Button x:Name="ScanStopButton" Content="{Binding [Scan.Stop], Source={x:Static svc:Loc.Instance}}" Click="ScanStop_Click"
                        IsEnabled="False" Padding="14,8" Margin="0,0,0,6"/>
              </WrapPanel>
              <TextBlock x:Name="ScanHintText" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11"
                         Foreground="{StaticResource SecondaryTextBrush}"/>
            </StackPanel>
          </Border>

          <Border Grid.Row="1" Background="{StaticResource InfoBgBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock x:Name="ScanStatusText" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" FontSize="11.5"/>
              <ProgressBar x:Name="ScanProgress" Height="5" Margin="0,8,0,0" Minimum="0" Maximum="1" Value="0"/>
            </StackPanel>
          </Border>

          <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="14">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="1.35*"/>
              </Grid.RowDefinitions>

              <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                  <Button x:Name="TreeViewButton" Content="{Binding [Chart.Treemap], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource SegButton}"
                          Click="ViewMode_Click" Tag="treemap" Background="{StaticResource AccentBrush}" Foreground="White" BorderBrush="{StaticResource AccentBrush}"/>
                  <Button x:Name="SunViewButton" Content="{Binding [Chart.Sunburst], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource SegButton}"
                          Click="ViewMode_Click" Tag="sunburst"/>
                  <Button x:Name="BarViewButton" Content="{Binding [Chart.Bars], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource SegButton}"
                          Click="ViewMode_Click" Tag="bars" Margin="0,0,14,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button x:Name="ColorTypeButton" Content="{Binding [Chart.ByType], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource SegButton}"
                          Click="ColorMode_Click" Tag="type" Background="{StaticResource AccentBrush}" Foreground="White" BorderBrush="{StaticResource AccentBrush}"/>
                  <Button x:Name="ColorDepthButton" Content="{Binding [Chart.ByDepth], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource SegButton}"
                          Click="ColorMode_Click" Tag="depth"/>
                  <Button x:Name="ColorSizeButton" Content="{Binding [Chart.BySize], Source={x:Static svc:Loc.Instance}}" Style="{StaticResource SegButton}"
                          Click="ColorMode_Click" Tag="size"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                  <CheckBox x:Name="MergeSmallCheck" Content="{Binding [Chart.MergeSmall], Source={x:Static svc:Loc.Instance}}" Margin="0,0,12,0"
                            Checked="MergeSmall_Changed" Unchecked="MergeSmall_Changed"/>
                  <TextBlock x:Name="ChartSummary" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"/>
                </StackPanel>
              </Grid>

              <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="ScanUpButton" Grid.Column="0" Content="{Binding [Scan.Up], Source={x:Static svc:Loc.Instance}}" Click="ScanUp_Click"
                        IsEnabled="False" Padding="12,6" Margin="0,0,10,0"/>
                <TextBlock x:Name="ScanPathText" Grid.Column="1" VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}" FontSize="11.5"
                           TextTrimming="CharacterEllipsis"/>
                <Button x:Name="CleanupRulesButton" Grid.Column="2" Content="{Binding [Scan.Rules], Source={x:Static svc:Loc.Instance}}"
                        Click="CleanupRules_Click" Padding="12,6" Margin="0,0,10,0"
                        ToolTip="{Binding [Scan.RulesTip], Source={x:Static svc:Loc.Instance}}"/>
                <Button x:Name="DeleteSelectedButton" Grid.Column="3" Content="{Binding [Scan.DeleteSelected], Source={x:Static svc:Loc.Instance}}"
                        Click="DeleteSelected_Click" Padding="12,6" Margin="0,0,10,0"
                        IsEnabled="False" ToolTip="{Binding [Scan.DeleteTip], Source={x:Static svc:Loc.Instance}}"/>
                <TextBlock x:Name="ScanNodeSummary" Grid.Column="4" VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}" FontSize="11.5"/>
              </Grid>

              <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                      Background="{StaticResource SubtleBrush}" ClipToBounds="True" Margin="0,0,0,10">
                <Grid>
                  <ctl:TreemapView x:Name="TreemapChart"/>
                  <ctl:SunburstView x:Name="SunburstChart" Visibility="Collapsed"/>
                  <ctl:BarsView x:Name="BarsChart" Visibility="Collapsed"/>
                </Grid>
              </Border>

              <ListView x:Name="ScanResultList" Grid.Row="3" BorderThickness="0"
                        SelectionMode="Extended" SelectionChanged="ScanResultList_SelectionChanged"
                        MouseDoubleClick="ScanResultList_MouseDoubleClick">
                <ListView.View>
                  <GridView>
                    <GridViewColumn Header="{Binding [List.Name], Source={x:Static svc:Loc.Instance}}" Width="330" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="{Binding [List.Type], Source={x:Static svc:Loc.Instance}}" Width="110" DisplayMemberBinding="{Binding KindText}"/>
                    <GridViewColumn Header="{Binding [List.Size], Source={x:Static svc:Loc.Instance}}" Width="110" DisplayMemberBinding="{Binding SizeDisplay}"/>
                    <GridViewColumn Header="{Binding [List.Modified], Source={x:Static svc:Loc.Instance}}" Width="150" DisplayMemberBinding="{Binding TimeDisplay}"/>
                    <GridViewColumn Header="{Binding [List.State], Source={x:Static svc:Loc.Instance}}" Width="80" DisplayMemberBinding="{Binding StateBadge}"/>
                  </GridView>
                </ListView.View>
              </ListView>
            </Grid>
          </Border>
        </Grid>
        <Grid x:Name="DuplicatesPanel" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

          <Border Grid.Row="0" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,10">
            <StackPanel>
              <WrapPanel>
                <TextBlock Text="{Binding [Dup.Volume], Source={x:Static svc:Loc.Instance}}" VerticalAlignment="Center" Margin="0,0,6,6" Foreground="{StaticResource SecondaryTextBrush}"/>
                <ComboBox x:Name="DupVolumeCombo" Width="130" Margin="0,0,6,6"
                          SelectionChanged="DupVolume_SelectionChanged"/>
                <Button x:Name="DupBrowseButton" Content="{Binding [Dup.Browse], Source={x:Static svc:Loc.Instance}}"
                        Click="DupBrowse_Click" Padding="10,6" Margin="0,0,14,6"
                        Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                <TextBlock Text="{Binding [Dup.MinSize], Source={x:Static svc:Loc.Instance}}" VerticalAlignment="Center" Margin="0,0,6,6" Foreground="{StaticResource SecondaryTextBrush}"/>
                <ComboBox x:Name="DupMinSizeCombo" Width="110" Margin="0,0,14,6" SelectedIndex="0">
                  <ComboBoxItem Content="1 MB" Tag="1048576"/>
                  <ComboBoxItem Content="4 MB" Tag="4194304"/>
                  <ComboBoxItem Content="16 MB" Tag="16777216"/>
                </ComboBox>
                <Button x:Name="DupStartButton" Content="{Binding [Dup.Start], Source={x:Static svc:Loc.Instance}}"
                        Click="DupStart_Click" Padding="16,8" Margin="0,0,8,6"
                        Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"/>
                <Button x:Name="DupCancelButton" Content="{Binding [Dup.Cancel], Source={x:Static svc:Loc.Instance}}"
                        Click="DupCancel_Click" Padding="14,8" Margin="0,0,0,6" IsEnabled="False"/>
              </WrapPanel>
              <TextBlock x:Name="DupStatusText" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                         Foreground="{StaticResource SecondaryTextBrush}"/>
              <ProgressBar x:Name="DupProgress" Height="5" Margin="0,8,0,0" Minimum="0" Maximum="1" Value="0"/>
            </StackPanel>
          </Border>

          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="9" Margin="0,0,10,0">
              <ListBox x:Name="DupGroupList" BorderThickness="0" Background="Transparent"
                       SelectionChanged="DupGroupList_SelectionChanged">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="8,6">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding WastedText}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="9">
              <DataGrid x:Name="DupFileGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                        CanUserDeleteRows="False" CanUserResizeRows="False" HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal" BorderThickness="0" Background="Transparent"
                        RowHeaderWidth="0" SelectionMode="Single">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Width="42">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding IsDeletable}"
                                  Checked="DupFile_Checked" Unchecked="DupFile_Checked"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn IsReadOnly="True" Width="*"
                                      Header="{Binding [Dup.Path], Source={x:Static svc:Loc.Instance}}"
                                      Binding="{Binding Path}"/>
                  <DataGridTextColumn IsReadOnly="True" Width="90"
                                      Header="{Binding [Dup.Size], Source={x:Static svc:Loc.Instance}}"
                                      Binding="{Binding SizeText}"/>
                  <DataGridTextColumn IsReadOnly="True" Width="145"
                                      Header="{Binding [Dup.Modified], Source={x:Static svc:Loc.Instance}}"
                                      Binding="{Binding ModifiedText}"/>
                  <DataGridTextColumn IsReadOnly="True" Width="150"
                                      Header="{Binding [Dup.Flags], Source={x:Static svc:Loc.Instance}}"
                                      Binding="{Binding Flags}"/>
                  <DataGridTextColumn IsReadOnly="True" Width="170"
                                      Header="{Binding [Dup.Note], Source={x:Static svc:Loc.Instance}}"
                                      Binding="{Binding Note}"/>
                </DataGrid.Columns>
              </DataGrid>
            </Border>
          </Grid>

          <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="{Binding [Dup.ScanHint], Source={x:Static svc:Loc.Instance}}" VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" MaxWidth="700"/>
            <Button x:Name="DupCleanButton" DockPanel.Dock="Right" Content="{Binding [Dup.Clean], Source={x:Static svc:Loc.Instance}}"
                    Click="DupClean_Click" Padding="14,7" IsEnabled="False"
                    Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"/>
            <TextBlock x:Name="DupSelectionText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                       Foreground="{StaticResource SecondaryTextBrush}" FontSize="11.5"/>
          </DockPanel>
        </Grid>
        <Grid x:Name="AppsPanel" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

          <Border Grid.Row="0" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,10">
            <StackPanel>
              <WrapPanel>
                <TextBox x:Name="AppSearchBox" Width="220" Padding="8,6" Margin="0,0,12,6"
                         ToolTip="{Binding [Apps.Search], Source={x:Static svc:Loc.Instance}}"
                         TextChanged="AppFilter_Changed"/>
                <TextBlock Text="{Binding [Apps.SourceFilter], Source={x:Static svc:Loc.Instance}}"
                           VerticalAlignment="Center" Margin="0,0,6,6" Foreground="{StaticResource SecondaryTextBrush}"/>
                <ComboBox x:Name="AppSourceCombo" Width="150" Margin="0,0,12,6" SelectedIndex="0"
                          SelectionChanged="AppFilter_Changed">
                  <ComboBoxItem Content="{Binding [Apps.Source.All], Source={x:Static svc:Loc.Instance}}" Tag="all"/>
                  <ComboBoxItem Content="{Binding [Apps.Source.Desktop], Source={x:Static svc:Loc.Instance}}" Tag="desktop"/>
                  <ComboBoxItem Content="{Binding [Apps.Source.Store], Source={x:Static svc:Loc.Instance}}" Tag="store"/>
                </ComboBox>
                <TextBlock Text="{Binding [Apps.Sort], Source={x:Static svc:Loc.Instance}}"
                           VerticalAlignment="Center" Margin="0,0,6,6" Foreground="{StaticResource SecondaryTextBrush}"/>
                <ComboBox x:Name="AppSortCombo" Width="120" Margin="0,0,12,6" SelectedIndex="0"
                          SelectionChanged="AppFilter_Changed">
                  <ComboBoxItem Content="{Binding [Apps.Sort.Size], Source={x:Static svc:Loc.Instance}}" Tag="size"/>
                  <ComboBoxItem Content="{Binding [Apps.Sort.Name], Source={x:Static svc:Loc.Instance}}" Tag="name"/>
                  <ComboBoxItem Content="{Binding [Apps.Sort.InstallDate], Source={x:Static svc:Loc.Instance}}" Tag="installed"/>
                </ComboBox>
                <CheckBox x:Name="AppOnlyUninstallableCheck"
                          Content="{Binding [Apps.OnlyUninstallable], Source={x:Static svc:Loc.Instance}}"
                          VerticalAlignment="Center" Margin="0,0,12,6"
                          Checked="AppFilter_Changed" Unchecked="AppFilter_Changed"/>
                <Button x:Name="AppRefreshButton" Content="{Binding [Apps.Redetect], Source={x:Static svc:Loc.Instance}}"
                        Click="AppRefresh_Click" Padding="14,7" Margin="0,0,0,6"
                        Background="{StaticResource SoftBrush}" Foreground="{StaticResource AccentBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
              </WrapPanel>
              <TextBlock x:Name="AppStatusText" FontSize="11" TextWrapping="Wrap"
                         Foreground="{StaticResource SecondaryTextBrush}"/>
              <TextBlock Text="{Binding [Apps.Note], Source={x:Static svc:Loc.Instance}}"
                         FontSize="10.5" TextWrapping="Wrap" Margin="0,5,0,0"
                         Foreground="{StaticResource SecondaryTextBrush}"/>
            </StackPanel>
          </Border>

          <Border Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1" CornerRadius="9">
            <DataGrid x:Name="AppGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserDeleteRows="False" CanUserResizeRows="False" CanUserSortColumns="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"
                      Background="Transparent" RowHeaderWidth="0" IsReadOnly="True" SelectionMode="Single">
              <DataGrid.Columns>
                <DataGridTextColumn Width="*" Header="{Binding [Apps.Col.Name], Source={x:Static svc:Loc.Instance}}"
                                    Binding="{Binding Name}"/>
                <DataGridTextColumn Width="150" Header="{Binding [Apps.Col.Publisher], Source={x:Static svc:Loc.Instance}}"
                                    Binding="{Binding Publisher}"/>
                <DataGridTextColumn Width="90" Header="{Binding [Apps.Col.Version], Source={x:Static svc:Loc.Instance}}"
                                    Binding="{Binding Version}"/>
                <DataGridTextColumn Width="95" Header="{Binding [Apps.Col.InstallDate], Source={x:Static svc:Loc.Instance}}"
                                    Binding="{Binding InstallDateText}"/>
                <DataGridTextColumn Width="110" Header="{Binding [Apps.Col.Size], Source={x:Static svc:Loc.Instance}}"
                                    Binding="{Binding SizeText}"/>
                <DataGridTextColumn Width="95" Header="{Binding [Apps.Col.Source], Source={x:Static svc:Loc.Instance}}"
                                    Binding="{Binding SourceText}"/>
                <DataGridTemplateColumn Width="210"
                                        Header="{Binding [Apps.Col.Status], Source={x:Static svc:Loc.Instance}}">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"
                                 ToolTip="{Binding StatusText}" VerticalAlignment="Center" Margin="4,0"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="88"
                                        Header="{Binding [Apps.Col.Action], Source={x:Static svc:Loc.Instance}}">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Button Content="{Binding ActionText}" Tag="{Binding}" Click="AppUninstall_Click"
                              IsEnabled="{Binding CanUninstall}" Padding="10,4" Margin="4,2"
                              HorizontalContentAlignment="Center"
                              Background="{StaticResource SoftBrush}" Foreground="{StaticResource AccentBrush}"
                              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                              ToolTip="{Binding StatusText}"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </Grid>
        <Grid x:Name="HardwarePanel" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

          <Border Grid.Row="0" Background="{StaticResource CardBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
              <TextBlock Text="{Binding [HW.Title], Source={x:Static svc:Loc.Instance}}"
                         FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"
                         VerticalAlignment="Center"/>
              <Button x:Name="HardwareRefreshButton" DockPanel.Dock="Right" Click="HardwareRefresh_Click"
                      Content="{Binding [HW.Refresh], Source={x:Static svc:Loc.Instance}}" Padding="14,7"
                      Background="{StaticResource SoftBrush}" Foreground="{StaticResource AccentBrush}"
                      BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="10,0,0,0"/>
              <Button x:Name="HardwareDiagnosticsButton" DockPanel.Dock="Right" Click="HardwareDiagnostics_Click"
                      Content="{Binding [HW.Diagnostics], Source={x:Static svc:Loc.Instance}}" Padding="14,7"
                      Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                      Margin="10,0,0,0"/>
              <TextBlock x:Name="HardwareStatusText" DockPanel.Dock="Right" VerticalAlignment="Center"
                         Foreground="{StaticResource SecondaryTextBrush}" FontSize="11.5" Margin="0,0,10,0"/>
            </DockPanel>
          </Border>

          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="400"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="9" Margin="0,0,10,0">
              <ListView x:Name="HardwareDiskList" BorderThickness="0" Background="Transparent"
                        SelectionMode="Single" SelectionChanged="HardwareDiskList_SelectionChanged">
                <ListView.View>
                  <GridView>
                    <GridViewColumn Header="{Binding [HW.Model], Source={x:Static svc:Loc.Instance}}" Width="150" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="{Binding [HW.Bus], Source={x:Static svc:Loc.Instance}}" Width="70" DisplayMemberBinding="{Binding Bus}"/>
                    <GridViewColumn Header="{Binding [HW.Media], Source={x:Static svc:Loc.Instance}}" Width="85" DisplayMemberBinding="{Binding Media}"/>
                    <GridViewColumn Header="{Binding [HW.Health], Source={x:Static svc:Loc.Instance}}" Width="65" DisplayMemberBinding="{Binding Health}"/>
                    <GridViewColumn Header="{Binding [HW.Size], Source={x:Static svc:Loc.Instance}}" Width="80" DisplayMemberBinding="{Binding Size}"/>
                  </GridView>
                </ListView.View>
              </ListView>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="9">
              <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                <StackPanel>
                  <TextBlock x:Name="HwTitleText" FontSize="16" FontWeight="SemiBold"
                             Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap"/>
                  <TextBlock x:Name="HwAdminHintText" Margin="0,5,0,10" FontSize="11"
                             Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Visibility="Collapsed"/>

                  <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding [HW.Serial], Source={x:Static svc:Loc.Instance}}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,10,4"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="HwSerialText" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="1" Text="{Binding [HW.Firmware], Source={x:Static svc:Loc.Instance}}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,10,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="HwFirmwareText" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="2" Text="{Binding [HW.Bus], Source={x:Static svc:Loc.Instance}}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,10,4"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="HwBusText" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="3" Text="{Binding [HW.Media], Source={x:Static svc:Loc.Instance}}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,10,4"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="HwMediaText" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="4" Text="{Binding [HW.Health], Source={x:Static svc:Loc.Instance}}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,10,4"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="HwHealthText" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="5" Text="{Binding [HW.Size], Source={x:Static svc:Loc.Instance}}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,10,4"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="HwSizeText" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="6" Text="{Binding [HW.Location], Source={x:Static svc:Loc.Instance}}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,10,4"/>
                    <TextBlock Grid.Row="6" Grid.Column="1" x:Name="HwLocationText" TextWrapping="Wrap" Margin="0,0,0,4"/>
                  </Grid>

                  <TextBlock Text="{Binding [HW.Reliability], Source={x:Static svc:Loc.Instance}}"
                             FontWeight="SemiBold" Margin="0,6,0,4"/>
                  <TextBlock x:Name="HwReliabilityNote" Foreground="{StaticResource WarningTextBrush}"
                             FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                  <ItemsControl x:Name="HwReliabilityList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="0,0,0,5">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource SecondaryTextBrush}" Width="170"/>
                            <TextBlock Text="{Binding Value}" FontWeight="SemiBold"/>
                          </StackPanel>
                          <TextBlock Text="{Binding Note}" FontSize="10.5" Foreground="{StaticResource SecondaryTextBrush}"
                                     TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBlock Text="{Binding [HW.Partitions], Source={x:Static svc:Loc.Instance}}"
                             FontWeight="SemiBold" Margin="0,12,0,4"/>
                  <ItemsControl x:Name="HwPartitionList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="11.5" Margin="0,0,0,3"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>
        </Grid>
        <Border x:Name="PlaceholderPanel" Visibility="Collapsed" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="30">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="PlaceholderTitle" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="PlaceholderDescription" Margin="0,12,0,0" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" MaxWidth="500" TextAlignment="Center"/>
          </StackPanel>
        </Border>
      </Grid>
      <DockPanel Grid.Row="3" Margin="0,14,0,0">
        <TextBlock x:Name="StatusText" Foreground="{StaticResource SecondaryTextBrush}"/>
        <TextBlock DockPanel.Dock="Right" Text="{Binding [Footer.Safety], Source={x:Static svc:Loc.Instance}}"
                   Foreground="{StaticResource SecondaryTextBrush}"/>
      </DockPanel>
    </Grid>
  </Grid>
</Window>
