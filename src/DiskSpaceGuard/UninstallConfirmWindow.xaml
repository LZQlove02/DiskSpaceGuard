<Window x:Class="DiskSpaceGuard.UninstallConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:DiskSpaceGuard.Services"
        Title="{Binding [Apps.Confirm.Title], Source={x:Static svc:Loc.Instance}}"
        Width="680" Height="620" MinWidth="600" MinHeight="520"
        WindowStartupLocation="CenterOwner" Foreground="{DynamicResource PrimaryTextBrush}" Background="{DynamicResource WindowBrush}"
        ShowInTaskbar="False" FontFamily="{StaticResource UiFontFamily}" FontSize="13">
  <Border Padding="22">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0">
        <TextBlock x:Name="HeadingText" FontSize="20" FontWeight="Bold"
                   Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap"/>
        <TextBlock x:Name="MetaText" Margin="0,6,0,0" FontSize="11.5"
                   Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
        <TextBlock x:Name="LocationText" Margin="0,3,0,0" FontSize="11.5"
                   Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
      </StackPanel>

      <StackPanel Grid.Row="1" Margin="0,12,0,0">
        <Border x:Name="DependentNote" Background="{DynamicResource WarningBgBrush}" CornerRadius="7"
                Padding="10,8" Margin="0,0,0,8">
          <TextBlock Text="{Binding [Apps.Confirm.Dependent], Source={x:Static svc:Loc.Instance}}"
                     Foreground="{DynamicResource WarningTextBrush}" FontSize="11.5" TextWrapping="Wrap"/>
        </Border>
        <Border x:Name="DevNote" Background="{DynamicResource WarningBgBrush}" CornerRadius="7"
                Padding="10,8" Margin="0,0,0,8">
          <TextBlock Text="{Binding [Apps.Confirm.Dev], Source={x:Static svc:Loc.Instance}}"
                     Foreground="{DynamicResource WarningTextBrush}" FontSize="11.5" TextWrapping="Wrap"/>
        </Border>
        <Border x:Name="PreinstalledNote" Background="{DynamicResource InfoBgBrush}" CornerRadius="7"
                Padding="10,8" Margin="0,0,0,8">
          <TextBlock Text="{Binding [Apps.Confirm.Preinstalled], Source={x:Static svc:Loc.Instance}}"
                     Foreground="{DynamicResource AccentBrush}" FontSize="11.5" TextWrapping="Wrap"/>
        </Border>
        <Border x:Name="ElevationNote" Background="{DynamicResource InfoBgBrush}" CornerRadius="7"
                Padding="10,8" Margin="0,0,0,8">
          <TextBlock Text="{Binding [Apps.Confirm.Elevation], Source={x:Static svc:Loc.Instance}}"
                     Foreground="{DynamicResource AccentBrush}" FontSize="11.5" TextWrapping="Wrap"/>
        </Border>
      </StackPanel>

      <Border Grid.Row="2" Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="14" Margin="0,4,0,0">
        <StackPanel>
          <TextBlock Text="{Binding [Apps.Confirm.Command], Source={x:Static svc:Loc.Instance}}"
                     Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,6"/>
          <TextBox x:Name="CommandText" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{StaticResource MonoFontFamily}"
                   FontSize="11.5" Padding="8,6" MinHeight="58" MaxHeight="130"
                   VerticalScrollBarVisibility="Auto" Background="{DynamicResource SubtleBrush}"
                   BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
          <CheckBox x:Name="QuietCheck" Margin="0,10,0,0"
                    Content="{Binding [Apps.Confirm.Quiet], Source={x:Static svc:Loc.Instance}}"
                    Checked="QuietCheck_Changed" Unchecked="QuietCheck_Changed"/>
          <TextBlock x:Name="QuietWarn" Margin="22,4,0,0" FontSize="11"
                     Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap"
                     Text="{Binding [Apps.Confirm.QuietWarn], Source={x:Static svc:Loc.Instance}}"
                     Visibility="Collapsed"/>
        </StackPanel>
      </Border>

      <Border Grid.Row="3" Background="{DynamicResource SuccessBgBrush}" CornerRadius="7"
              Padding="10,8" Margin="0,10,0,0">
        <TextBlock Text="{Binding [Apps.Confirm.Boundary], Source={x:Static svc:Loc.Instance}}"
                   Foreground="{DynamicResource SuccessTextBrush}" FontSize="11.5" TextWrapping="Wrap"/>
      </Border>

      <DockPanel Grid.Row="5" Margin="0,14,0,0" LastChildFill="False">
        <Button DockPanel.Dock="Right" x:Name="ExecuteButton"
                Content="{Binding [Apps.Confirm.Execute], Source={x:Static svc:Loc.Instance}}"
                Click="Execute_Click" Padding="20,8" Margin="0"
                Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource OnAccentBrush}" BorderThickness="0"/>
        <Button DockPanel.Dock="Right"
                Content="{Binding [Common.Cancel], Source={x:Static svc:Loc.Instance}}"
                Click="Cancel_Click" Padding="18,8" Margin="0,0,10,0"
                Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
      </DockPanel>
    </Grid>
  </Border>
</Window>
